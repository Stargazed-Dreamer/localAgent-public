      "id": "scan_disk",
      "name": "磁盘空间扫描",
      "category": "disk",
      "description": "紧凑空间分析（scan tree/drill 下钻/find 按目录名定位/files 最大文件），--json 直返上下文",
      "script": "workspace/disk_manager/scripts/scan_disk.py",
      "command": ".venv\\Scripts\\python.exe workspace/disk_manager/scripts/scan_disk.py scan <path> --json",
      "usage": "agent",
      "requires_browser": false,
      "requires_admin": false,
      "options": [
        {"name": "scan <path>", "description": "紧凑 tree JSON（默认深度4、每层top10）"},
        {"name": "drill <path>", "description": "下钻指定子目录（默认深度5）"},
        {"name": "find <path> <names...>", "description": "按目录名定位+大小（如 node_modules .venv）"},
        {"name": "files <path>", "description": "最大单个文件 top N"},
        {"name": "-d <N>", "default": "4", "description": "深度上限"},
        {"name": "-n <N>", "default": "10", "description": "每层 top N"},
        {"name": "--json", "description": "JSON 直返 stdout（agent 用）"}
      ],
      "notes": "symlink/junction 不跟随；硬上限保护（depth/files/dirs）；旧 --overview/--deep/--large 已移除",
      "user_facing": false
    },
    {
      "id": "cleanup_disk",
      "name": "磁盘清理",
      "category": "disk",
      "description": "磁盘清理（dry-run 出逐项可回收字节回执 → 用户勾选 → --delete 走 ctypes 回收站删除）",
      "script": "workspace/disk_manager/scripts/cleanup.py",
      "command": ".venv\\Scripts\\python.exe workspace/disk_manager/scripts/cleanup.py --dry-run --json",
      "usage": "agent",
      "requires_browser": false,
      "requires_admin": true,
      "options": [
        {"name": "--dry-run", "description": "出逐项回执（id/path/size），不删任何文件"},
        {"name": "--delete --items <ids>", "description": "只删确认项，走 ctypes 回收站（可恢复）"},
        {"name": "--json", "description": "JSON 直返 stdout（agent 用）"}
      ],
      "notes": "两步闭环：先 --dry-run 拿 id → 用户勾选 → --delete --items <ids>；删除走回收站可恢复；路径白名单保护",
      "user_facing": false
    },
