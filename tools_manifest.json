    {
      "id": "start_debug_browser",
      "name": "启动调试浏览器",
      "category": "system",
      "description": "启动独立调试浏览器实例（支持 Chromium 内核：Chrome / Edge / Brave / Vivaldi 等，端口 9222，不影响工作浏览器）",
      "script": "tools/browser/start_debug_browser.py",
      "command": ".venv\\Scripts\\python.exe tools/browser/start_debug_browser.py",
      "usage": "agent",
      "requires_browser": false,
      "requires_admin": false,
      "options": [
        "--copy-user-data   从源浏览器复制用户数据（登录态/扩展）",
        "--no-copy          不复制用户数据，使用空白配置（默认行为）",
        "--browser-path PATH  显式指定浏览器可执行文件路径（默认自动探测）",
        "--port N           自定义调试端口（默认 9222）",
        "--user-data-dir PATH  自定义用户数据目录（默认 <项目根>/chrome_debug）"
      ],
      "notes": "通用版本：未指定 --browser-path 时按优先级自动探测 Chrome/Edge/Brave/Vivaldi。首次使用可加 --copy-user-data 从源浏览器复制登录态到 user_data_dir。",
      "user_facing": true
    },
