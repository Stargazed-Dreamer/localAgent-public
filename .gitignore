# release engine v2 build artifacts (dist/ + staging/)
# dist/ 存最终 zip + sha256 sidecar；staging/ 存构建中间产物（失败时改名 .failed.zip）
# 两者都是本地构建产物，不进仓库；保留 .gitkeep 让目录结构进 git
release/dist/*
!release/dist/.gitkeep
release/staging/*
!release/staging/.gitkeep

